PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillmatch
DB_USER=skillmatch_app
DB_PASSWORD=CAMBIAR_EN_EL_ARCHIVO_LOCAL

# Obligatorio. Mínimo 16 caracteres. Nunca lo publiques en el repositorio.
# Puedes generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esta_clave_en_produccion

# Formato de jsonwebtoken: 1h, 30m, 7d, etc.
JWT_EXPIRES_IN=1h
