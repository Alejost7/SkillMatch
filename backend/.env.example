# Puerto del servidor. En Railway se inyecta automáticamente: no lo definas.
PORT=3000

# Interfaz de escucha. 0.0.0.0 es obligatorio en contenedores (Railway).
# Con 127.0.0.1 el proxy de la plataforma no alcanza el proceso.
# HOST=0.0.0.0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillmatch
DB_USER=skillmatch_app
DB_PASSWORD=CAMBIAR_EN_EL_ARCHIVO_LOCAL

# TLS hacia MySQL:
#   (vacío) o false  -> sin cifrar. Sirve para el MySQL local.
#   true / required  -> cifrado sin validar el certificado. Railway lo EXIGE
#                       porque su MySQL usa un certificado autofirmado.
#   verify / strict  -> cifrado validando el certificado (sólo si la CA es de
#                       confianza pública).
# DB_SSL=true

# Obligatorio. Mínimo 16 caracteres. Nunca lo publiques en el repositorio.
# Puedes generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esta_clave_en_produccion

# Formato de jsonwebtoken: 1h, 30m, 7d, etc.
JWT_EXPIRES_IN=1h

